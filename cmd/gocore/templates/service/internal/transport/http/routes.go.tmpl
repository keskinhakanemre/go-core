// Package http maps routes to use case handlers. It is the only place that
// knows about URLs, HTTP methods and success status codes.
//
// Routes registered through httpserver.Get/Post/... are documented
// automatically in the OpenAPI document (/openapi.json) and Swagger UI (/docs).
package http

import (
	"github.com/gofiber/fiber/v2"

	"[[.CoreModule]]/httpserver"

	"[[.Module]]/internal/app/product"
)

// Handlers lists every use case exposed over HTTP.
type Handlers struct {
	CreateProduct httpserver.Handler[product.CreateProductRequest, product.ProductResponse]
	GetProduct    httpserver.Handler[product.GetProductRequest, product.ProductResponse]
	ListProducts  httpserver.Handler[product.ListProductsRequest, product.ListProductsResponse]
}

// Register mounts all routes on api.
func Register(api *httpserver.API, h Handlers) {
	api.DescribeTag("Products", "Product catalogue")

	products := api.Group("/api/v1/products", "Products")
	httpserver.Post(products, "", h.CreateProduct,
		httpserver.WithStatus(fiber.StatusCreated),
		httpserver.WithSummary("Create a product"),
		httpserver.WithOperationID("CreateProduct"))
	httpserver.Get(products, "", h.ListProducts,
		httpserver.WithSummary("List products"),
		httpserver.WithOperationID("ListProducts"))
	httpserver.Get(products, "/:id", h.GetProduct,
		httpserver.WithSummary("Get a product"),
		httpserver.WithOperationID("GetProduct"),
		httpserver.WithErrors(fiber.StatusNotFound))
}
