package http_test

import (
	"encoding/json"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gofiber/fiber/v2"

	coreconfig "[[.CoreModule]]/config"
	"[[.CoreModule]]/httpserver"

	"[[.Module]]/internal/app/product"
	"[[.Module]]/internal/infra/memory"
	transporthttp "[[.Module]]/internal/transport/http"
)

func newApp() *fiber.App {
	repo := memory.NewProductRepository()
	app := httpserver.New(coreconfig.HTTPConfig{})
	transporthttp.Register(app, transporthttp.Handlers{
		CreateProduct: product.NewCreateProductHandler(repo),
		GetProduct:    product.NewGetProductHandler(repo),
		ListProducts:  product.NewListProductsHandler(repo),
	})
	return app
}

func call(t *testing.T, app *fiber.App, method, path, body string) (int, string) {
	t.Helper()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	resp, err := app.Test(req)
	if err != nil {
		t.Fatal(err)
	}
	defer func() { _ = resp.Body.Close() }()
	b, _ := io.ReadAll(resp.Body)
	return resp.StatusCode, string(b)
}

func TestProductRoutes(t *testing.T) {
	app := newApp()

	status, body := call(t, app, http.MethodPost, "/api/v1/products", `{"name":"pen","price":150}`)
	if status != http.StatusCreated {
		t.Fatalf("create: %d %s", status, body)
	}
	var created product.ProductResponse
	if err := json.Unmarshal([]byte(body), &created); err != nil {
		t.Fatal(err)
	}

	if status, body = call(t, app, http.MethodGet, "/api/v1/products/"+created.ID, ""); status != http.StatusOK {
		t.Fatalf("get: %d %s", status, body)
	}
	if status, body = call(t, app, http.MethodGet, "/api/v1/products?limit=10", ""); status != http.StatusOK || !strings.Contains(body, `"total":1`) {
		t.Fatalf("list: %d %s", status, body)
	}
}

func TestProductRouteErrors(t *testing.T) {
	app := newApp()
	cases := []struct {
		method, path, body string
		status             int
		code               string
	}{
		{http.MethodGet, "/api/v1/products/0b8a4b6e-0f3e-4a8b-9a55-6b3c8e1f0a11", "", 404, "product_not_found"},
		{http.MethodGet, "/api/v1/products/not-a-uuid", "", 422, "validation_failed"},
		{http.MethodPost, "/api/v1/products", `{"name":"x"}`, 422, "validation_failed"},
		{http.MethodPost, "/api/v1/products", `{"name":`, 400, "invalid_body"},
		{http.MethodGet, "/api/v1/products?limit=1000", "", 422, "validation_failed"},
	}
	for _, tc := range cases {
		status, body := call(t, app, tc.method, tc.path, tc.body)
		if status != tc.status || !strings.Contains(body, `"code":"`+tc.code+`"`) {
			t.Errorf("%s %s: got %d %s, want %d %s", tc.method, tc.path, status, body, tc.status, tc.code)
		}
	}
}
